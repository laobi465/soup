# ============================================================
# Root .gitignore - admin-system
# 覆盖：Node、PHP、Composer、Vite、IDE、系统、环境、日志、缓存
# ============================================================

# ---------- 环境变量（绝不提交）----------
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# ---------- Node / 前端 ----------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store/

# ---------- PHP / Composer / ThinkPHP ----------
backend/vendor/
backend/runtime/
backend/.env
composer.lock
*.log

# ---------- 构建产物 ----------
build/
dist/
*.tgz

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.sublime-*

# ---------- Docker ----------
docker/data/
docker/mysql/
docker/redis/
docker/logs/
docker/.env

# ---------- 日志 ----------
logs/
*.log

# ---------- 测试 / 覆盖率 ----------
coverage/
.phpunit.result.cache
.phpunit.cache/

# ---------- 安全 / 密钥 ----------
*.pem
*.key
*.crt
secrets/
