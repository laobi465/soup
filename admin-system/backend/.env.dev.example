; ============================================================
; admin-system 后端 开发环境 配置样例
; 复制为 .env 后替换占位符 {{...}} 使用
; ============================================================

[APP]
APP_NAME = admin-system-dev
APP_NAMESPACE = app
APP_DEBUG = true
APP_TRACE = true
APP_DEFAULT_TIMEZONE = Asia/Shanghai
APP_DEFAULT_LANG = zh-cn
APP_DEFAULT_FILTER = trim,htmlspecialchars
APP_HOST = http://127.0.0.1:8000
APP_HTTPS = false

[DB]
DB_TYPE = mysql
DB_HOSTNAME = 127.0.0.1
DB_HOSTPORT = 3306
DB_DATABASE = admin_system_dev
DB_USERNAME = {{DB_USERNAME}}
DB_PASSWORD = {{DB_PASSWORD}}
DB_CHARSET = utf8mb4
DB_PREFIX = as_
DB_DEPLOY = 0
DB_RW_SEPARATE = false
DB_FIELDS_CACHE = true
DB_TRIGGER_SQL = true
DB_BREAK_RECONNECT = true
DB_MAX_RETRY = 3

[REDIS]
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = {{REDIS_PASSWORD}}
REDIS_SELECT = 0
REDIS_TIMEOUT = 5
REDIS_PERSISTENT = false
REDIS_PREFIX = admin_system_dev_

[CACHE]
CACHE_DRIVER = redis
CACHE_EXPIRE = 3600
CACHE_PREFIX = admin_cache_dev_

[JWT]
JWT_SECRET = {{JWT_SECRET_DEV}}
JWT_ALG = HS256
JWT_TTL = 7200
JWT_REFRESH_TTL = 604800
JWT_ISS = admin-system-dev
JWT_AUD = admin-system
JWT_LEEWAY = 60
JWT_BLACKLIST_ENABLED = true

[UPLOAD]
UPLOAD_TYPE = local
UPLOAD_PATH = /data/admin-system/uploads/dev
UPLOAD_URL = http://127.0.0.1:8000/uploads
UPLOAD_MAX_SIZE = 10485760
UPLOAD_ALLOW_EXT = jpg,jpeg,png,gif,bmp,webp,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,7z,txt
UPLOAD_ALLOW_MIME = image/jpeg,image/png,image/gif,application/pdf,application/zip,text/plain
UPLOAD_HASH_NAME = true

[LOG]
LOG_TYPE = file
LOG_PATH = /data/admin-system/logs/dev
LOG_LEVEL = debug
LOG_MAX_FILES = 7
LOG_APART_LEVEL = true
LOG_FORMAT = [%datetime%][%level_name%] %message% %context% %extra%\n
LOG_USE_REDIS = false

[CORS]
CORS_ALLOW_ORIGIN = *
CORS_ALLOW_METHODS = GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS = Content-Type,Authorization,X-Requested-With,X-Token,X-CSRF-Token,Accept,Origin
CORS_EXPOSE_HEADERS = Content-Length,Content-Range,X-Total-Count
CORS_ALLOW_CREDENTIALS = false
CORS_MAX_AGE = 86400

[RATE_LIMIT]
RATE_LIMIT_ENABLED = true
RATE_LIMIT_MAX = 600
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_DRIVER = redis

[PAGINATION]
PAGE_SIZE_DEFAULT = 20
PAGE_SIZE_MAX = 100

[SECURITY]
SECURITY_PASSWORD_SALT = {{SECURITY_PASSWORD_SALT_DEV}}
SECURITY_PASSWORD_METHOD = PASSWORD_BCRYPT
SECURITY_PASSWORD_COST = 10
SECURITY_TOKEN_NAME = Authorization
SECURITY_TOKEN_PREFIX = Bearer
