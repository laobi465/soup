; ============================================================
; admin-system 后端 生产环境 配置样例
; 复制为 .env 后替换占位符 {{...}} 使用
; 生产环境必须严格使用强随机字符串作为密钥
; ============================================================

[APP]
APP_NAME = admin-system
APP_NAMESPACE = app
APP_DEBUG = false
APP_TRACE = false
APP_DEFAULT_TIMEZONE = Asia/Shanghai
APP_DEFAULT_LANG = zh-cn
APP_DEFAULT_FILTER = trim,htmlspecialchars
APP_HOST = {{APP_HOST}}
APP_HTTPS = true

[DB]
DB_TYPE = mysql
DB_HOSTNAME = {{DB_HOSTNAME}}
DB_HOSTPORT = {{DB_HOSTPORT}}
DB_DATABASE = admin_system_prod
DB_USERNAME = {{DB_USERNAME}}
DB_PASSWORD = {{DB_PASSWORD}}
DB_CHARSET = utf8mb4
DB_PREFIX = as_
DB_DEPLOY = 0
DB_RW_SEPARATE = true
DB_FIELDS_CACHE = true
DB_TRIGGER_SQL = false
DB_BREAK_RECONNECT = true
DB_MAX_RETRY = 5

[REDIS]
REDIS_HOST = {{REDIS_HOST}}
REDIS_PORT = {{REDIS_PORT}}
REDIS_PASSWORD = {{REDIS_PASSWORD}}
REDIS_SELECT = 0
REDIS_TIMEOUT = 3
REDIS_PERSISTENT = true
REDIS_PREFIX = admin_system_prod_

[CACHE]
CACHE_DRIVER = redis
CACHE_EXPIRE = 1800
CACHE_PREFIX = admin_cache_prod_

[JWT]
JWT_SECRET = {{JWT_SECRET_PROD}}
JWT_ALG = HS256
JWT_TTL = 3600
JWT_REFRESH_TTL = 86400
JWT_ISS = admin-system-prod
JWT_AUD = admin-system
JWT_LEEWAY = 60
JWT_BLACKLIST_ENABLED = true

[UPLOAD]
UPLOAD_TYPE = {{UPLOAD_TYPE}}
UPLOAD_PATH = {{UPLOAD_PATH}}
UPLOAD_URL = {{UPLOAD_URL}}
UPLOAD_MAX_SIZE = 10485760
UPLOAD_ALLOW_EXT = jpg,jpeg,png,gif,bmp,webp,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,7z,txt
UPLOAD_ALLOW_MIME = image/jpeg,image/png,image/gif,application/pdf,application/zip,text/plain
UPLOAD_HASH_NAME = true

[LOG]
LOG_TYPE = file
LOG_PATH = {{LOG_PATH}}
LOG_LEVEL = warning
LOG_MAX_FILES = 90
LOG_APART_LEVEL = true
LOG_FORMAT = [%datetime%][%level_name%] %message% %context% %extra%\n
LOG_USE_REDIS = false

[CORS]
CORS_ALLOW_ORIGIN = {{CORS_ALLOW_ORIGIN}}
CORS_ALLOW_METHODS = GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS = Content-Type,Authorization,X-Requested-With,X-Token,X-CSRF-Token,Accept,Origin
CORS_EXPOSE_HEADERS = Content-Length,Content-Range,X-Total-Count
CORS_ALLOW_CREDENTIALS = false
CORS_MAX_AGE = 86400

[RATE_LIMIT]
RATE_LIMIT_ENABLED = true
RATE_LIMIT_MAX = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_DRIVER = redis

[PAGINATION]
PAGE_SIZE_DEFAULT = 20
PAGE_SIZE_MAX = 100

[SECURITY]
SECURITY_PASSWORD_SALT = {{SECURITY_PASSWORD_SALT_PROD}}
SECURITY_PASSWORD_METHOD = PASSWORD_BCRYPT
SECURITY_PASSWORD_COST = 12
SECURITY_TOKEN_NAME = Authorization
SECURITY_TOKEN_PREFIX = Bearer
