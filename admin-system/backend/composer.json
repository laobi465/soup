{
    "name": "admin-system/backend",
    "description": "Enterprise admin system backend built on ThinkPHP 8",
    "type": "project",
    "keywords": [
        "admin",
        "thinkphp",
        "backend",
        "rbac",
        "jwt"
    ],
    "homepage": "https://github.com/admin-system/backend",
    "license": "MIT",
    "authors": [
        {
            "name": "AdminSystem Team",
            "email": "dev@admin-system.local"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-bcmath": "*",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-migration": "^3.0",
        "firebase/php-jwt": "^6.10",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/",
            "config\\": "config/"
        },
        "files": [
            "app/common/helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "allow-plugins": {
            "topthink/think-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ],
        "test": "phpunit",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "fix-style": "php-cs-fixer fix"
    },
    "extra": {
        "think": {
            "services": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
