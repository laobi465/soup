; ============================================================
; admin-system 后端通用环境配置样例
; 复制为 .env 并替换占位符 {{...}} 后使用
; 零硬编码原则：所有运行时配置必须从此文件读取
; ============================================================

; ---------------- 应用全局配置 ----------------
[APP]
APP_NAME = {{APP_NAME}}
APP_NAMESPACE = app
APP_DEBUG = false
APP_TRACE = false
APP_DEFAULT_TIMEZONE = Asia/Shanghai
APP_DEFAULT_LANG = zh-cn
APP_DEFAULT_FILTER = trim,htmlspecialchars
APP_HOST = {{APP_HOST}}
APP_HTTPS = false

; ---------------- 数据库配置 ----------------
[DB]
DB_TYPE = mysql
DB_HOSTNAME = {{DB_HOSTNAME}}
DB_HOSTPORT = {{DB_HOSTPORT}}
DB_DATABASE = {{DB_DATABASE}}
DB_USERNAME = {{DB_USERNAME}}
DB_PASSWORD = {{DB_PASSWORD}}
DB_CHARSET = utf8mb4
DB_PREFIX = as_
DB_DEPLOY = 0
DB_RW_SEPARATE = false
DB_FIELDS_CACHE = true
DB_TRIGGER_SQL = true
DB_BREAK_RECONNECT = true
DB_MAX_RETRY = 3

; ---------------- Redis 配置 ----------------
[REDIS]
REDIS_HOST = {{REDIS_HOST}}
REDIS_PORT = {{REDIS_PORT}}
REDIS_PASSWORD = {{REDIS_PASSWORD}}
REDIS_SELECT = 0
REDIS_TIMEOUT = 5
REDIS_PERSISTENT = false
REDIS_PREFIX = admin_system_

; ---------------- 缓存配置 ----------------
[CACHE]
CACHE_DRIVER = redis
CACHE_EXPIRE = 3600
CACHE_PREFIX = admin_cache_

; ---------------- JWT 配置 ----------------
[JWT]
JWT_SECRET = {{JWT_SECRET}}
JWT_ALG = HS256
JWT_TTL = 7200
JWT_REFRESH_TTL = 604800
JWT_ISS = {{JWT_ISS}}
JWT_AUD = admin-system
JWT_LEEWAY = 60
JWT_BLACKLIST_ENABLED = true

; ---------------- 上传配置 ----------------
[UPLOAD]
UPLOAD_TYPE = local
UPLOAD_PATH = /data/admin-system/uploads
UPLOAD_URL = {{UPLOAD_URL}}
UPLOAD_MAX_SIZE = 10485760
UPLOAD_ALLOW_EXT = jpg,jpeg,png,gif,bmp,webp,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,7z,txt
UPLOAD_ALLOW_MIME = image/jpeg,image/png,image/gif,application/pdf,application/zip,text/plain
UPLOAD_HASH_NAME = true

; ---------------- 日志配置 ----------------
[LOG]
LOG_TYPE = file
LOG_PATH = /data/admin-system/logs
LOG_LEVEL = info
LOG_MAX_FILES = 30
LOG_APART_LEVEL = true
LOG_FORMAT = [%datetime%][%level_name%] %message% %context% %extra%\n
LOG_USE_REDIS = false

; ---------------- CORS 跨域配置 ----------------
[CORS]
CORS_ALLOW_ORIGIN = {{CORS_ALLOW_ORIGIN}}
CORS_ALLOW_METHODS = GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS = Content-Type,Authorization,X-Requested-With,X-Token,X-CSRF-Token,Accept,Origin
CORS_EXPOSE_HEADERS = Content-Length,Content-Range,X-Total-Count
CORS_ALLOW_CREDENTIALS = false
CORS_MAX_AGE = 86400

; ---------------- 限流配置 ----------------
[RATE_LIMIT]
RATE_LIMIT_ENABLED = true
RATE_LIMIT_MAX = 60
RATE_LIMIT_WINDOW = 60
RATE_LIMIT_DRIVER = redis

; ---------------- 分页配置 ----------------
[PAGINATION]
PAGE_SIZE_DEFAULT = 20
PAGE_SIZE_MAX = 100

; ---------------- 安全配置 ----------------
[SECURITY]
SECURITY_PASSWORD_SALT = {{SECURITY_PASSWORD_SALT}}
SECURITY_PASSWORD_METHOD = PASSWORD_BCRYPT
SECURITY_PASSWORD_COST = 10
SECURITY_TOKEN_NAME = Authorization
SECURITY_TOKEN_PREFIX = Bearer
