# ============================================================
# Docker Compose 环境变量示例 - admin-system
# 使用方法：cp .env.example .env 后修改对应值
# 严禁提交真实 .env 文件到 Git 仓库
# ============================================================

# ---------- 全局 ----------
APP_NAME=admin-system
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_LANG=zh-cn

# ---------- 后端 PHP ----------
BACKEND_PORT=8080
PHP_VERSION=8.2-fpm

# ---------- 前端 Nginx ----------
FRONTEND_PORT=80

# ---------- MySQL 8.0 ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=admin_system
MYSQL_ROOT_PASSWORD=change_me_to_strong_root_pwd_2024
MYSQL_USER=admin_system
MYSQL_PASSWORD=change_me_to_strong_pwd_2024
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_pwd_2024
REDIS_DB=0

# ---------- JWT ----------
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long_xxxxxx
JWT_TTL=7200
JWT_REFRESH_TTL=604800

# ---------- 文件上传 ----------
UPLOAD_MAX_SIZE=20
UPLOAD_TYPE=local
UPLOAD_PATH=/var/www/html/backend/public/uploads

# ---------- 日志 ----------
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---------- 跨域 ----------
CORS_ALLOW_ORIGIN=https://admin.example.com
