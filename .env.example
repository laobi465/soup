# Docker Compose 环境变量样例
# 复制为 .env 并填入实际值 (或直接运行 ./deploy.sh init 自动生成强密码)

# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-strong-minio-password
MINIO_BUCKET=card-auth

# MySQL (compose 用, server/.env 复用此密码)
MYSQL_ROOT_PASSWORD=your-strong-mysql-password

# Redis (compose 中 redis --requirepass 强制要求, 缺失容器拒绝启动)
REDIS_PASSWORD=your-strong-redis-password

# APK 签名 keystore (仅启用 APK 注入功能时需要)
# 生成 keystore 后，将密码填入此处。keystore 文件放在 deploy/keystore/platform.keystore
# 生成命令：keytool -genkeypair -keystore deploy/keystore/platform.keystore -alias platform -keyalg RSA -keysize 2048 -validity 3650
APK_KEYSTORE_PASSWORD=
APK_KEYSTORE_ALIAS=platform
