# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# Docker Compose override (deploy.sh 自动生成用于解决端口冲突)
docker-compose.override.yml

# Runtime
server/runtime/
server/public/uploads/

# Docker
docker/mysql/data/
docker/redis/data/

# 签名密钥（运行时通过 volume 挂载，不入库）
deploy/keystore/
*.keystore
*.jks
*.p12
*.pfx
# keystore 密码文件 (防御性, 即使移到其他位置也不入库)
*.keystore-password.txt
.keystore-password.txt

# SSL 证书（deploy.sh 自动生成自签证书，不入库）
docker/nginx/ssl/
# 其他常见证书格式 (Let's Encrypt 等)
*.pem
*.crt
*.key

# 数据库备份 (deploy.sh backup 可能输出到仓库内)
*.sql
*.sql.gz

# Test coverage
coverage/
*.lcov

# Temporary files
*.tmp
*.temp
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
