# 生产环境必须修改所有密钥
APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
DEFAULT_LANG = zh-cn
APP_SECRET_KEY = your-app-secret-key-change-this-at-least-32-chars

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
DATABASE = card_auth
USERNAME = root
PASSWORD = your_mysql_root_password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = ca_

[REDIS]
HOST = redis
PORT = 6379
PASSWORD =
SELECT = 0

[CACHE]
DRIVER = redis

[JWT]
SECRET = your-jwt-secret-key-change-this-to-random-32chars
EXPIRE = 7200
REFRESH_EXPIRE = 604800
ALGORITHM = HS256

[QUEUE]
DRIVER = sync

[MINIO]
ENDPOINT = http://minio:9000
BUCKET = card-auth
ACCESS_KEY = minioadmin
SECRET_KEY = your-minio-password
USE_SSL = false

[APK_INJECT]
SERVICE_URL = http://apk-inject-service:8080
# 必填：APK 签名 keystore 密码，无默认值。生成 keystore 后填入实际密码
# 生成命令见 deploy/keystore/.keystore-password.txt（不入库）
KEYSTORE_PASSWORD =
KEYSTORE_ALIAS = platform
