# 生产环境必须修改所有密钥
APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
DEFAULT_LANG = zh-cn
APP_SECRET_KEY = your-app-secret-key-change-this-at-least-32-chars

[DATABASE]
TYPE = mysql
HOSTNAME = mysql
DATABASE = card_auth
USERNAME = root
PASSWORD = your_mysql_root_password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = ca_

[REDIS]
HOST = redis
PORT = 6379
PASSWORD =
SELECT = 0

[CACHE]
DRIVER = redis

[JWT]
SECRET = your-jwt-secret-key-change-this-to-random-32chars
EXPIRE = 7200
REFRESH_EXPIRE = 604800
ALGORITHM = HS256

[QUEUE]
DRIVER = sync
