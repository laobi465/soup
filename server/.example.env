APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
DEFAULT_LANG = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = card_auth
USERNAME = root
PASSWORD = your_password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = ca_

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0

[CACHE]
DRIVER = redis

[JWT]
SECRET = your-jwt-secret-key
EXPIRE = 7200
REFRESH_EXPIRE = 604800

[QUEUE]
DRIVER = redis
